# Keep production secrets private. Run `npm run cms:setup` locally to generate development secrets.
PAYLOAD_SECRET=
PAYLOAD_PREVIEW_SECRET=

# Leave DATABASE_URL blank to use the local SQLite database in ./data.
# Set DATABASE_URL for a PostgreSQL deployment.
DATABASE_URL=

# Optional: set to 1 after applying a schema migration to an existing database.
PAYLOAD_DISABLE_SCHEMA_PUSH=
