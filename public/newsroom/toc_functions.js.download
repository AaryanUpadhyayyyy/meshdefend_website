(()=>{const SCROLL_OFFSET=150;const toc_elements=document.querySelectorAll(".toc_item_link");if(!toc_elements.length)return;toc_elements.forEach((tocItem)=>{tocItem.classList.add("data_link");tocItem.dataset.link=tocItem.id.replace(/^data-/,"")});document.querySelectorAll(".data_link").forEach((element)=>{element.addEventListener("click",(event)=>{event.preventDefault();const targetId=event.currentTarget.dataset.link;const targetSection=targetId&&document.getElementById(targetId);if(!targetSection)return;window.scrollTo({top:targetSection.getBoundingClientRect().top+window.scrollY-SCROLL_OFFSET,behavior:"smooth",});if(!targetSection.hasAttribute("tabindex"))targetSection.setAttribute("tabindex","-1");targetSection.focus({preventScroll:!0})})});const sections=Array.from(document.querySelectorAll(".scroll-item"));const visibleSections=new Set();const setActive=(sectionId)=>{const links=sectionId?document.querySelectorAll(`.toc_item_link[data-link="${CSS.escape(sectionId)}"]`):[];if(sectionId&&!links.length)return;document.querySelectorAll(".data_link_active").forEach((el)=>{el.classList.remove("data_link_active");el.removeAttribute("aria-current")});links.forEach((link)=>{link.classList.add("data_link_active");link.setAttribute("aria-current","true")})};const getFallbackSection=()=>{const passed=sections.filter((section)=>section.getBoundingClientRect().top<=SCROLL_OFFSET);return passed[passed.length-1]??sections[0]};const handleIntersection=(entries)=>{entries.forEach((entry)=>{if(entry.isIntersecting)visibleSections.add(entry.target);else visibleSections.delete(entry.target)});const activeSection=sections.find((section)=>visibleSections.has(section))??getFallbackSection();setActive(activeSection?.id)};const observer=new IntersectionObserver(handleIntersection,{root:null,rootMargin:`-${SCROLL_OFFSET}px 0px -60% 0px`,threshold:0,});sections.forEach((section)=>observer.observe(section))})()